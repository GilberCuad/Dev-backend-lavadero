// ============================================================
// Schema de Prisma - Sistema de Gestión de Lavadero de Vehículos
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------
// Enums
// ------------------------------------------------------------

enum Rol {
  ADMIN
  OPERARIO
}

enum EstadoEmpleado {
  ACTIVO
  INACTIVO
}

enum TipoVehiculo {
  CARRO
  MOTO
}

enum EstadoRegistroServicio {
  EN_ESPERA
  EN_PROCESO
  TERMINADO
  ENTREGADO
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
}

// ------------------------------------------------------------
// Usuarios (login del sistema)
// ------------------------------------------------------------

model Usuario {
  id            String   @id @default(uuid())
  nombre        String
  email         String   @unique
  passwordHash  String   @map("password_hash")
  rol           Rol
  activo        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  registrosCreados RegistroServicio[] @relation("RegistroCreadoPor")
  pagosCreados     PagoEmpleado[]     @relation("PagoCreadoPor")

  @@map("usuarios")
}

// ------------------------------------------------------------
// Empleados
// ------------------------------------------------------------

model Empleado {
  id            String         @id @default(uuid())
  nombre        String
  documento     String         @unique
  cargo         String
  fechaIngreso  DateTime       @map("fecha_ingreso")
  estado        EstadoEmpleado @default(ACTIVO)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  pagos            PagoEmpleado[]
  serviciosPrestados RegistroServicioEmpleado[]

  @@map("empleados")
}

// ------------------------------------------------------------
// Pagos a empleados
// ------------------------------------------------------------

model PagoEmpleado {
  id           String   @id @default(uuid())
  empleadoId   String   @map("empleado_id")
  monto        Decimal  @db.Decimal(10, 2)
  fechaPago    DateTime @map("fecha_pago")
  observacion  String?
  createdById  String   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")

  empleado  Empleado @relation(fields: [empleadoId], references: [id])
  createdBy Usuario  @relation("PagoCreadoPor", fields: [createdById], references: [id])

  @@map("pagos_empleados")
  @@index([fechaPago])
}

// ------------------------------------------------------------
// Vehículos (se reutilizan por placa)
// ------------------------------------------------------------

model Vehiculo {
  id        String       @id @default(uuid())
  placa     String       @unique
  tipo      TipoVehiculo
  createdAt DateTime     @default(now()) @map("created_at")

  registros RegistroServicio[]

  @@map("vehiculos")
}

// ------------------------------------------------------------
// Catálogo de servicios
// ------------------------------------------------------------

model Servicio {
  id     String  @id @default(uuid())
  nombre String
  precio Decimal @db.Decimal(10, 2)
  activo Boolean @default(true)

  detalles RegistroServicioDetalle[]

  @@map("servicios")
}

// ------------------------------------------------------------
// Registro de servicio (un ingreso de vehículo al lavadero)
// ------------------------------------------------------------

model RegistroServicio {
  id            String                 @id @default(uuid())
  vehiculoId    String                 @map("vehiculo_id")
  estado        EstadoRegistroServicio @default(EN_ESPERA)
  metodoPago    MetodoPago             @map("metodo_pago")
  fechaIngreso  DateTime               @default(now()) @map("fecha_ingreso")
  fechaEntrega  DateTime?              @map("fecha_entrega")
  total         Decimal                @db.Decimal(10, 2) // snapshot: suma de servicios al crear el registro
  createdById   String                 @map("created_by")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  vehiculo  Vehiculo @relation(fields: [vehiculoId], references: [id])
  createdBy Usuario  @relation("RegistroCreadoPor", fields: [createdById], references: [id])

  detalles  RegistroServicioDetalle[]
  empleados RegistroServicioEmpleado[]

  @@map("registros_servicio")
  @@index([fechaIngreso])
}

// ------------------------------------------------------------
// Detalle de servicios por registro (N:M registro <-> servicio)
// ------------------------------------------------------------

model RegistroServicioDetalle {
  id                 String  @id @default(uuid())
  registroServicioId String  @map("registro_servicio_id")
  servicioId         String  @map("servicio_id")
  precioAplicado     Decimal @map("precio_aplicado") @db.Decimal(10, 2) // precio congelado al momento de aplicarlo

  registroServicio RegistroServicio @relation(fields: [registroServicioId], references: [id], onDelete: Cascade)
  servicio         Servicio         @relation(fields: [servicioId], references: [id])

  @@map("registro_servicio_detalle")
  @@unique([registroServicioId, servicioId])
}

// ------------------------------------------------------------
// Empleados asignados por registro (N:M registro <-> empleado)
// ------------------------------------------------------------

model RegistroServicioEmpleado {
  id                 String @id @default(uuid())
  registroServicioId String @map("registro_servicio_id")
  empleadoId         String @map("empleado_id")

  registroServicio RegistroServicio @relation(fields: [registroServicioId], references: [id], onDelete: Cascade)
  empleado         Empleado         @relation(fields: [empleadoId], references: [id])

  @@map("registro_servicio_empleado")
  @@unique([registroServicioId, empleadoId])
}
